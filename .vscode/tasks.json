			"problemMatcher": []
		},
		{
			"label": "Docker: Oracle Down",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"down"
			],
			"problemMatcher": []
		},
		{
			"label": "Docker: Oracle Reset",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"down",
				"-v"
			],
			"problemMatcher": []
		},
		{
			"label": "Docker: Oracle Logs",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"logs",
				"-f",
